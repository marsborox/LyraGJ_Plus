  m_Script: {fileID: 11500000, guid: 5b64693eb50bb564dbefa613b86cb10f, type: 3}
  m_Name: JazzDialogue1_SO
  m_EditorClassIdentifier: 
  showAgain: 0
  parts:
  - dialogueText: You sure are hitting those notes. Just like a true jazz musician.
    character: 1
    emotion: 3
  - dialogueText: You think so? I'm just doing what I think sounds good.
    character: 0
    emotion: 1
  - dialogueText: Hah, maybe you didn't know this but jazz originated in New Orleans,
      and what made it so revolutionary was its improvisational approach.
    character: 1
    emotion: 0
  - dialogueText: Most jazz perfomers didn't prepare their solos... Instead, they
      improvised and used rhytm and chords to create a unique melody.
    character: 1
    emotion: 2
  - dialogueText: 'Wow. They improvised solos during perfomance?

      That''s amazing!'
    character: 0
    emotion: 1
  - dialogueText: That's the beauty of jazz! Most people don't even know where the
      word "jazz" originated from.
    character: 1
    emotion: 3
  - dialogueText: It's still a mystery to this day. But I guess that shows you the
      magic of music. You don't need to know everything to enjoy it.
    character: 1
    emotion: 3
  - dialogueText: ' I guess you''re right.'
    character: 0
    emotion: 3
  - dialogueText: But enough talking! Let's hit some more tunes.
    character: 1
    emotion: 2
  fileName: JazzDialogue1_SO
