  m_Script: {fileID: 11500000, guid: 5b64693eb50bb564dbefa613b86cb10f, type: 3}
  m_Name: JazzBossFinale_SO
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue_SO
  showAgain: 1
  parts:
  - dialogueText: That was... amazing.
    character: 0
    emotion: 3
  - dialogueText: Hahaha, I see you haven't lost your touch Charlie. That were some
      killer tunes!
    character: 1
    emotion: 3
  - dialogueText: Thank you, thank you. A compliment from you is alway pleasure to
      hear.
    character: 2
    emotion: 3
  - dialogueText: So, Lyra what do you think?
    character: 2
    emotion: 1
  - dialogueText: That was something else! It was like you were one with your piano.
    character: 0
    emotion: 3
  - dialogueText: I'm not sure I can ever play that good.
    character: 0
    emotion: 4
  - dialogueText: That's what I said to myself after I lost my vision.
    character: 2
    emotion: 0
  - dialogueText: Lost... your vision?
    character: 0
    emotion: 6
  - dialogueText: Yes, I'm blind from my childhood. But that didn't stopped me from
      achieving my dreams.
    character: 2
    emotion: 0
  - dialogueText: And now look where I am!
    character: 2
    emotion: 3
  - dialogueText: So, don't worry Lyra. I'm sure whatever is troubling you, you will
      find a way and achieve your dreams.
    character: 2
    emotion: 2
  - dialogueText: Wow, thank you!
    character: 0
    emotion: 2
  - dialogueText: You taught me so much.
    character: 0
    emotion: 3
  - dialogueText: Thank you for your time, Charlie. We must continue now. Have a
      great one!
    character: 1
    emotion: 0
  - dialogueText: Glad to be a service. Take care you two.
    character: 1
    emotion: 3
  fileName: JazzBossFinale_SO
