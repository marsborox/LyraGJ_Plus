  showAgain: 1
  parts:
  - dialogueText: Umm, hello?
    character: 0
    emotion: 6
  - dialogueText: ...
    character: 2
    emotion: 0
  - dialogueText: Charlie, is that you?
    character: 1
    emotion: 1
  - dialogueText: My good friend, fancy meeting you here!
    character: 1
    emotion: 3
  - dialogueText: ...
    character: 2
    emotion: 0
  - dialogueText: Something is wrong.
    character: 1
    emotion: 6
  - dialogueText: What..?
    character: 0
    emotion: 6
  - dialogueText: This is my good friend, Charles Ray.
    character: 1
    emotion: 0
  - dialogueText: We played together from time to time. His piano skills are magical
      and his voice is angelic.
    character: 1
    emotion: 3
  - dialogueText: ...
    character: 2
    emotion: 0
  - dialogueText: Or used to be.
    character: 1
    emotion: 5
  - dialogueText: What happened to him? His music is...
    character: 0
    emotion: 5
  - dialogueText: Yes, Lyra. He lost his connection to music. He needs your help.
    character: 1
    emotion: 5
  - dialogueText: I'm not sure what to do. I'm not ready to heal others.
    character: 0
    emotion: 6
  - dialogueText: You must try. Charlie deserves to be heard again.
    character: 1
    emotion: 2
  fileName: JazzBossDialogue0_SO
