  m_Script: {fileID: 11500000, guid: 5b64693eb50bb564dbefa613b86cb10f, type: 3}
  m_Name: DarkLobbyDialogue_SO
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue_SO
  showAgain: 0
  parts:
  - dialogueText: ....
    character: 0
    emotion: 5
  - dialogueText: Sorry mother, it looks like I won't be able to keep my promise
      to you.
    character: 0
    emotion: 5
  - dialogueText: Well look what we have here?
    character: 1
    emotion: 1
  - dialogueText: Aaah!
    character: 0
    emotion: 6
  - dialogueText: Sorry darling, didn't mean to scare you. I didnt expect anyone
      to visit my small and humble opera at this time of the year. Is everything
      alright?
    character: 1
    emotion: 1
  - dialogueText: Yes I am alright. Sorry for bothering, I just wanted some peace
      and quiet to think.
    character: 0
    emotion: 5
  - dialogueText: Wait. You said "My small and humble opera"?
    character: 1
    emotion: 1
  - dialogueText: Yes, my name is Julius Pedro and welcome to my opera house. While
      it seen better days, I am glad there are still people that finds time to visit
      this place.
    character: 1
    emotion: 3
  - dialogueText: 'Now, may I ask your name and what bring such a pretty lady to
      my opera? '
    character: 1
    emotion: 3
  - dialogueText: I'm Lyra. And well, you see.... I used to visit this place when
      I was little with my mother. She loved this opera and the plays here.
    character: 0
    emotion: 4
  - dialogueText: So I promised her, that when I grow up I will sing in this opera
      for her to make her happy and be proud of me.
    character: 0
    emotion: 4
  - dialogueText: That is beautiful promise. Now being the gentleman that, I feel
      obliged to help you.
    character: 1
    emotion: 2
  - dialogueText: While I know this place isn't what it used to be, I can offer you
      any help you need for making a show for your mother.
    character: 1
    emotion: 3
  - dialogueText: I appriciate the offer but sadly I don' think you can help me.
      You see I can't sing anymore because I lost my voice.
    character: 0
    emotion: 5
  - dialogueText: 'It got badly damaged during training and no medicine helped me
      healed it. '
    character: 0
    emotion: 4
  - dialogueText: Now this is the time where I disagree hon. There are other ways
      for you to heal. Here, let me show you the magic of music!
    character: 1
    emotion: 3
  - dialogueText: Magic of music?
    character: 0
    emotion: 1
  - dialogueText: Yes! Follow my instructions, feel the music and you will see the
      fruits of your hard work. Let's look at jazz first to see what it has to offer.
    character: 1
    emotion: 2
  - dialogueText: Let's start the show
    character: 1
    emotion: 2
  - dialogueText: 'Woah, okay. '
    character: 1
    emotion: 2
  fileName: DarkLobbyDialogue_SO
