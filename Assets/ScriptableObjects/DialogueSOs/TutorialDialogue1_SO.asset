  parts:
  - dialogueText: Nicely played, honey! Onto the next instrument?
    character: 1
    emotion: 3
  - dialogueText: Here's my old piano. Give it a try and let its sweet-sweet melody
      wash over you.
    character: 1
    emotion: 3
  - dialogueText: 'Let me guess: play it to break a shield of a different color?'
    character: 0
    emotion: 1
  - dialogueText: You are a natural!
    character: 1
    emotion: 6
  - dialogueText: On it!
    character: 0
    emotion: 3
