  m_Script: {fileID: 11500000, guid: 5b64693eb50bb564dbefa613b86cb10f, type: 3}
  m_Name: NewTutorialDialoguePiano_SO
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue_SO
  showAgain: 1
  parts:
  - dialogueText: Onto the next instrument?
    character: 1
    emotion: 3
  - dialogueText: Here's my old piano. Give it a try and let its sweet-sweet melody
      wash over you.
    character: 1
    emotion: 3
  - dialogueText: You know what to do?
    character: 1
    emotion: 1
  - dialogueText: 'Let me guess: play it to break an enemy of a different color?'
    character: 0
    emotion: 1
  - dialogueText: Yes, dear but have you noticed hitting harder when you synchronize
      your playing with the rhythm of the music?
    character: 1
    emotion: 1
  - dialogueText: 'Not really... but when you mention it: Is rhythm marked by that
      green indicator flying around my heart?'
    character: 1
    emotion: 1
  - dialogueText: You are a natural!
    character: 1
    emotion: 6
  fileName: TutorialDialogue1_SO
